rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: checks if request user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: checks if request user is in permanent root admin allowlist
    function isPermanentAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)^(admin\\.yellownetwork@gmail\\.com|yellownetwork@gmail\\.com|mdrahat73184@gmail\\.com)$')
      );
    }

    // Helper: checks if request user is an organizational admin
    function isAdmin() {
      return isAuthenticated() && (
        isPermanentAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole in ['Super Admin', 'District Coordinator'])
      );
    }

    // Helper: checks if user is a designated moderator
    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole == 'Moderator')
      );
    }

    // 1. PERMANENT USERS COLLECTION (Identified by Firebase Auth UID)
    // Never deleted by yearly resets or unauthorized users
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin()) &&
        (!('adminRole' in request.resource.data) || request.resource.data.adminRole == 'General Member' || isPermanentAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) &&
        (!('adminRole' in request.resource.data) || request.resource.data.adminRole == resource.data.adminRole || isAdmin() || isPermanentAdmin());
      allow delete: if false; // Permanent user profiles are strictly protected from deletion
    }

    // 2. PERMANENT VOLUNTEERS DIRECTORY
    match /volunteers/{volunteerId} {
      allow read: if true; // Public roster & link/QR verification
      allow create: if isAuthenticated() && (isOwner(volunteerId) || isAdmin()) &&
        (!('adminRole' in request.resource.data) || request.resource.data.adminRole == 'General Member' || isPermanentAdmin());
      allow update: if isAuthenticated() && (isOwner(volunteerId) || isAdmin()) &&
        (!('adminRole' in request.resource.data) || request.resource.data.adminRole == resource.data.adminRole || isAdmin() || isPermanentAdmin());
      allow delete: if isAdmin(); // Only admins can delete volunteers
    }

    // 3. OPERATIONAL: PROJECTS & MEETINGS (Year-Specific)
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated() && isModerator();
      allow update: if isAuthenticated(); // Enables attendees to join/leave and admins to manage
      allow delete: if isAdmin(); // Only admins can delete initiatives
    }

    // 4. OPERATIONAL: ACTIVITY LOGS
    match /activityLogs/{logId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.volunteerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 5. OPERATIONAL: NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 6. OPERATIONAL: RADIO BROADCASTS & COMMENTS
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /radioBroadcasts/{broadcastId} {
      allow read: if true;
      allow create: if isAuthenticated() && isModerator();
      allow update: if isAuthenticated(); // Poll voting, likes, and reactions
      allow delete: if isAdmin();
    }

    match /radioComments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );
    }

    // 7. OPERATIONAL: COMMUNITY NEED ASSESSMENTS
    match /needAssessments/{needId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // Community voting and admin fulfillment
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.createdBy != null && resource.data.createdBy.id == request.auth.uid)
      );
    }

    // 8. BOARD PHOTOS & ASSETS
    match /boardPhotos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. SYSTEM AUDIT LOGS (Immutable record for yearly reset & system ops)
    match /systemAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
